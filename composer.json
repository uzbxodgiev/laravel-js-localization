{
  "name": "fardo/js-localization",
  "description": "Laravel package to provide localizations to the Javascript code.",
  "keywords": ["laravel", "javascript", "localization", "translation", "messages"],
  "license": "MIT",
  "authors": [
    {
      "name": "Andy Wermke",
      "email": "andy@dev.next-step-software.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0|^12.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.0",
    "phpunit/phpunit": "^11.0",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "JsLocalization\\": "src/"
    }
  },
  "autoload-dev": {
    "classmap": [
      "tests/TestCase.php"
    ]
  },
  "extra": {
    "component": "package",
    "frameworks": ["Laravel 7", "Laravel 8", "Laravel 9", "Laravel 10", "Laravel 11", "Laravel 12"]
  },
  "minimum-stability": "dev",
  "repositories": [
    {
      "type": "vcs",
      "url": "git://github.com/orchestral/phpseclib.git"
    }
  ]
}
